<Window x:Class="OWExtractor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OWExtractor.App"
        Title="OWExtractor · 素材库" Icon="Assets/OWExtractor.ico" Width="1360" Height="1000" MinWidth="1080" MinHeight="760"
        Background="White" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" KeyDown="WindowKeyDown">
  <Window.InputBindings><KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/><KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open"/></Window.InputBindings>
  <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Find" Executed="FindSkin"/><CommandBinding Command="ApplicationCommands.Open" Executed="ImportExports"/></Window.CommandBindings>
  <Window.Resources>
    <DataTemplate DataType="{x:Type local:SkinCard}">
      <Button Click="OpenSkinCard" Width="280" Padding="0" Margin="0,0,20,20" HorizontalContentAlignment="Stretch">
        <StackPanel><Border Background="{StaticResource LibraryCanvas}" Height="280" CornerRadius="8,8,0,0"><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="14"/></Border>
          <StackPanel Margin="16"><TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Description}" Style="{StaticResource Meta}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        </StackPanel>
      </Button>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:AudioCollectionCard}">
      <Button Width="280" Padding="0" Margin="0,0,20,20" HorizontalContentAlignment="Stretch" Click="Navigate" Tag="voices">
        <StackPanel><Border Background="#EDF2EE" Height="280" CornerRadius="8,8,0,0" Padding="22"><StackPanel VerticalAlignment="Center"><TextBlock Text="&#xE8D6;" Style="{StaticResource LibraryGlyph}" Margin="0,0,0,24"/><TextBlock Text="{Binding ChineseLabel}" Margin="0,0,0,14"/><TextBlock Text="{Binding EnglishLabel}" Margin="0,0,0,14"/><TextBlock Text="{Binding SoundEffectsLabel}"/></StackPanel></Border>
          <StackPanel Margin="16"><TextBlock Text="英雄声音" Style="{StaticResource SectionTitle}"/><TextBlock Text="历史语音、对话与音效统计" Style="{StaticResource Meta}" Margin="0,6,0,0"/></StackPanel>
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="AppRoot" Background="White">
    <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/></Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="#F5F7F6" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0" Padding="12,24,12,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,32"><Image Source="Assets/OWExtractor.png" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="OWExtractor" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
          <RadioButton Style="{StaticResource LibraryNav}" GroupName="LibraryNav" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=settings}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource LibraryGlyph}"/><TextBlock Text="设置"/></StackPanel></RadioButton>
          <StackPanel Orientation="Horizontal" Margin="12,18,0,0"><Ellipse Width="6" Height="6" Fill="#6C8B78" Margin="0,0,8,0"/><TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Meta}" Foreground="#536D60"/></StackPanel>
          <TextBlock Text="使用已有导出结果" Style="{StaticResource Meta}" Margin="12,4,0,0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="素材库" Style="{StaticResource Meta}" Margin="12,0,0,8"/>
          <RadioButton Style="{StaticResource LibraryNav}" GroupName="LibraryNav" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=all}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource LibraryGlyph}"/><TextBlock Text="全部资源"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource LibraryNav}" GroupName="LibraryNav" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=models}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" Style="{StaticResource LibraryGlyph}"/><TextBlock Text="模型与皮肤"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource LibraryNav}" GroupName="LibraryNav" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=music}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" Style="{StaticResource LibraryGlyph}"/><TextBlock Text="音乐"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource LibraryNav}" GroupName="LibraryNav" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=voices}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" Style="{StaticResource LibraryGlyph}"/><TextBlock Text="语音与音效"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource LibraryNav}" GroupName="LibraryNav" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=maps}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE707;" Style="{StaticResource LibraryGlyph}"/><TextBlock Text="地图"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource LibraryNav}" GroupName="LibraryNav" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=images}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" Style="{StaticResource LibraryGlyph}"/><TextBlock Text="图像与贴图"/></StackPanel></RadioButton>
          <TextBlock Text="工作区" Style="{StaticResource Meta}" Margin="12,28,0,8"/>
          <RadioButton Style="{StaticResource LibraryNav}" GroupName="LibraryNav" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=queue}" AutomationProperties.Name="提取队列入口"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding QueueCount}" Style="{StaticResource Meta}" VerticalAlignment="Center"/><TextBlock Text="&#xE8FD;" Style="{StaticResource LibraryGlyph}"/><TextBlock Text="提取队列"/></DockPanel></RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Column="1" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="28,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="导入资源" Click="OpenImportMenu" IsEnabled="{Binding CanEdit}" Margin="24,0,0,0" VerticalAlignment="Center">
          <Button.ContextMenu><ContextMenu><MenuItem Header="已有模型导出目录" Click="ImportExports"/><MenuItem Header="英雄列表（历史 JSON）" Click="ImportHeroes"/><MenuItem Header="皮肤目录（历史 JSON）" Click="ImportUnlocks"/><MenuItem Header="合并中文英雄名称" Click="ImportLocalized"/><Separator/><MenuItem Header="声音统计（历史 JSON）" Click="ImportAudioSummary"/><MenuItem Header="当前皮肤：3D 模型" Click="ImportModel" IsEnabled="{Binding HasSelectedSkin}"/><MenuItem Header="当前皮肤：正面缓存图" Click="ImportFrontPreview" IsEnabled="{Binding HasSelectedSkin}"/><MenuItem Header="当前皮肤：背面缓存图" Click="ImportBackPreview" IsEnabled="{Binding HasSelectedSkin}"/></ContextMenu></Button.ContextMenu>
        </Button>
        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE721;" Style="{StaticResource LibraryGlyph}"/>
          <TextBox x:Name="SkinSearchBox" Grid.Column="1" Text="{Binding LibrarySearch,UpdateSourceTrigger=PropertyChanged}" Tag="搜索本地素材库，按 Enter 查看结果" BorderThickness="0" Padding="4,8" KeyDown="SearchKeyDown" AutomationProperties.AutomationId="LibrarySearch"/>
          <Button Grid.Column="2" Content="搜索" Click="SubmitSearch" Style="{StaticResource QuietButton}" AutomationProperties.Name="搜索本地素材库"/>
        </Grid>
      </DockPanel>
    </Border>
    <Grid x:Name="PageArea" Grid.Row="1" Grid.Column="1" Margin="28,22,28,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Button Content="资源库" Style="{StaticResource QuietButton}" Padding="0" MinHeight="30" Click="Navigate" Tag="all"/>
          <TextBlock Text="›" Style="{StaticResource Meta}" Margin="12,0" VerticalAlignment="Center"/><TextBlock Text="{Binding PageName}" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
          <ComboBox x:Name="HeroPicker" ItemsSource="{Binding Heroes}" SelectedItem="{Binding SelectedHero}" DisplayMemberPath="Name" Width="160" MinHeight="32" Margin="18,0,0,0" Visibility="{Binding IsModelsPage,Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="选择英雄"/>
        </StackPanel>
        <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="打开文件夹" Click="OpenExport" IsEnabled="{Binding CanOpenExport}" Visibility="{Binding IsModelsPage,Converter={StaticResource VisibleWhenTrue}}" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel><TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" ToolTip="{Binding PageTitle}"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource Secondary}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PageSubtitle}"/></StackPanel>
        </DockPanel>
      </Grid>
      <Grid x:Name="LibraryArea" Grid.Row="1" Visibility="{Binding IsModelsPage,Converter={StaticResource VisibleWhenTrue}}">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="252"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="30"/><RowDefinition Height="104"/></Grid.RowDefinitions>
          <Border x:Name="PreviewCanvas" MinHeight="300" Background="{StaticResource LibraryCanvas}" CornerRadius="10" Padding="16,12,16,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="52"/></Grid.RowDefinitions>
              <DockPanel LastChildFill="False"><TextBlock Text="模型预览" DockPanel.Dock="Left" VerticalAlignment="Center"/><TextBlock Text="{Binding PreviewKind}" Style="{StaticResource Meta}" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#536D60"/></DockPanel>
              <Grid Grid.Row="1" Margin="0,6,0,6">
                <Image x:Name="ModelPreviewImage" Source="{Binding PreviewImage}" Stretch="Uniform" Visibility="{Binding ShowCachedPreview,Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="模型缓存预览"/>
                <local:ModelViewport x:Name="MainModelViewport" Scene="{Binding Scene}" Orbit="{Binding Camera}" SoftwareRendering="{Binding SoftwareRendering}" TargetFps="{Binding PreviewTargetFps}" ShowPerformance="{Binding ShowPreviewPerformance}" Visibility="{Binding ShowMainModel,Converter={StaticResource VisibleWhenTrue}}"/>
                <Border x:Name="PreviewWarning" Background="#FFF8E9" CornerRadius="6" Padding="12,8" VerticalAlignment="Top" Margin="6" Visibility="{Binding ShowPreviewWarning,Converter={StaticResource VisibleWhenTrue}}"><DockPanel><Button DockPanel.Dock="Right" Content="查看详情" Click="ShowModelDetails" Style="{StaticResource QuietButton}"/><TextBlock Text="3D 模型未能载入，当前显示缓存图。" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="310" Visibility="{Binding HasPreview,Converter={StaticResource VisibleWhenFalse}}"><TextBlock Text="本地模型预览" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/><TextBlock Text="{Binding ModelMessage}" Style="{StaticResource Meta}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,18"/><Button Content="选择已导出的模型" Click="ImportModel" IsEnabled="{Binding HasSelectedSkin}" HorizontalAlignment="Center"/></StackPanel>
              </Grid>
              <Border Grid.Row="2" BorderBrush="#DCE1D8" BorderThickness="0,1,0,0" Padding="0,6">
                <DockPanel LastChildFill="False">
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><RadioButton Content="正面" GroupName="MainView" Style="{StaticResource PreviewView}" IsChecked="{Binding FrontView}" IsEnabled="{Binding HasFrontPreview}"/><RadioButton Content="背面" GroupName="MainView" Style="{StaticResource PreviewView}" IsChecked="{Binding RearView}" IsEnabled="{Binding HasBackPreview}"/></StackPanel>
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="−" Click="ZoomOutModel" Style="{StaticResource QuietButton}" Width="34" IsEnabled="{Binding HasModel}" ToolTip="缩小（−）" AutomationProperties.Name="缩小模型"/><TextBlock Text="{Binding ZoomText}" Style="{StaticResource Meta}" Width="46" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Click="ZoomInModel" Style="{StaticResource QuietButton}" Width="34" IsEnabled="{Binding HasModel}" ToolTip="放大（+）" AutomationProperties.Name="放大模型"/><Button Content="适应" Click="FitModel" Style="{StaticResource QuietButton}" IsEnabled="{Binding HasModel}" ToolTip="适应窗口，保留当前视角（F）" AutomationProperties.Name="适应窗口"/><Button x:Name="ExpandPreviewButton" Style="{StaticResource QuietButton}" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" Width="38" Click="ExpandPreview" IsEnabled="{Binding HasPreview}" ToolTip="展开预览" AutomationProperties.Name="展开模型预览"/></StackPanel>
                </DockPanel>
              </Border>
            </Grid>
          </Border>
          <TextBlock Grid.Row="1" Text="{Binding PreviewHint}" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
          <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel><Button DockPanel.Dock="Right" Content="筛选与选择" Style="{StaticResource QuietButton}" MinHeight="26" Padding="8,0" Click="OpenImportMenu"><Button.ContextMenu><ContextMenu><MenuItem Header="全选皮肤" Click="SelectAll" IsEnabled="{Binding CanSelectAll}"/><MenuItem Header="清空选择" Click="ClearSelection"/><Separator/><MenuItem Header="仅已有结果" IsCheckable="True" IsChecked="{Binding ExistingOnly}"/></ContextMenu></Button.ContextMenu></Button><TextBlock Text="皮肤资源" VerticalAlignment="Center"/></DockPanel>
            <ListBox x:Name="SkinGrid" Grid.Row="1" ItemsSource="{Binding VisibleSkins}" SelectedItem="{Binding SelectedSkin}" SelectionMode="Extended" SelectionChanged="SkinSelectionChanged" ItemContainerStyle="{StaticResource LibraryCard}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="皮肤资源卡片">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="36" Height="48" Background="{StaticResource LibraryCanvas}" CornerRadius="4" HorizontalAlignment="Left"><Image Stretch="Uniform"><Image.Source><MultiBinding Converter="{StaticResource CachedImage}"><Binding Path="PreviewFrontPath"/><Binding Path="DataContext.Settings.GamePath" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Image.Source></Image></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding State}" Style="{StaticResource Meta}" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Text="{Binding EmptySkinTitle}" Style="{StaticResource Meta}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSkins,Converter={StaticResource VisibleWhenFalse}}"/>
          </Grid>
        </Grid>
        <Grid x:Name="ResourceInspector" Grid.Column="2">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><RadioButton x:Name="DetailsTab" Content="资源详情" GroupName="Inspector" Style="{StaticResource ResourceTab}" IsChecked="{Binding DetailsSelected}"/><RadioButton x:Name="ExportTab" Content="导出选项" GroupName="Inspector" Style="{StaticResource ResourceTab}" IsChecked="{Binding ExportOptionsSelected}"/></StackPanel></Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,8,0">
            <Grid>
              <StackPanel Visibility="{Binding DetailsSelected,Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Text="资源概览" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ResourceContentSummary}" Style="{StaticResource Meta}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                <StackPanel Style="{StaticResource InventoryRow}"><TextBlock Text="模型与材质"/><TextBlock Text="{Binding ModelsDetail}" Style="{StaticResource Meta}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Style="{StaticResource InventoryRow}"><TextBlock Text="贴图"/><TextBlock Text="{Binding TexturesDetail}" Style="{StaticResource Meta}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Style="{StaticResource InventoryRow}"><TextBlock Text="动画"/><TextBlock Text="{Binding AnimationsDetail}" Style="{StaticResource Meta}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Style="{StaticResource InventoryRow}"><TextBlock Text="关联音效"/><TextBlock Text="{Binding SoundsDetail}" Style="{StaticResource Meta}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Style="{StaticResource InventoryRow}"><TextBlock Text="装配数据"/><TextBlock Text="{Binding AssemblyDetail}" Style="{StaticResource Meta}" Margin="0,3,0,0"/></StackPanel>
                <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0"><Expander x:Name="ModelInfoExpander" Header="当前模型信息"><StackPanel><TextBlock Text="{Binding ModelFileName}" Style="{StaticResource Meta}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedSkin.PreviewModelPath}"/><TextBlock Text="{Binding ModelDetails}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="静态网格 · 初始姿态" Style="{StaticResource Meta}" Margin="0,6,0,12" Visibility="{Binding HasModel,Converter={StaticResource VisibleWhenTrue}}"/><Button Content="更换本地模型" Click="ImportModel" HorizontalAlignment="Left" IsEnabled="{Binding HasSelectedSkin}"/></StackPanel></Expander></Border>
                <TextBlock Text="来自本地历史导出" Style="{StaticResource Meta}" Foreground="#536D60" Margin="0,14,0,12"/>
              </StackPanel>
              <StackPanel x:Name="ExportOptionsPanel" Visibility="{Binding ExportOptionsSelected,Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding HasSelectedSkin}">
                <TextBlock Text="选择导出内容" Style="{StaticResource SectionTitle}"/><TextBlock Text="设置下一次提取包含的资源。" Style="{StaticResource Meta}" Margin="0,6,0,18"/>
                <StackPanel Margin="0,0,0,20"><TextBlock Text="✓  模型与材质"/><TextBlock Text="基础资源 · 自动包含" Style="{StaticResource Meta}" Margin="24,4,0,0"/></StackPanel>
                <CheckBox Content="贴图" IsChecked="{Binding IncludeTextures}"/><TextBlock Text="角色与装备的图像贴图" Style="{StaticResource Meta}" Margin="24,4,0,20"/>
                <CheckBox Content="动画" IsChecked="{Binding IncludeAnimations}"/><TextBlock Text="动作及关联动画文件" Style="{StaticResource Meta}" Margin="24,4,0,20"/>
                <CheckBox Content="关联音效" IsChecked="{Binding IncludeSound}"/><TextBlock Text="与当前资源关联的声音" Style="{StaticResource Meta}" Margin="24,4,0,20"/>
                <StackPanel Margin="0,0,0,20"><TextBlock Text="✓  装配数据"/><TextBlock Text="必要依赖 · 自动包含" Style="{StaticResource Meta}" Margin="24,4,0,0"/></StackPanel>
                <Button Content="恢复默认选项" Click="ResetContent" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-8,0,0,0"/>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="{Binding SelectedContentSummary}" Style="{StaticResource Meta}" TextWrapping="Wrap"/><Button x:Name="AddQueueButton" Content="加入待执行队列  →" Style="{StaticResource Primary}" Click="AddJobs" IsEnabled="{Binding CanAdd}" Height="42" Margin="0,10,0,0"/><TextBlock Text="{Binding QueueActionHint}" Style="{StaticResource Meta}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        </Grid>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLibraryPage,Converter={StaticResource VisibleWhenTrue}}"><StackPanel>
        <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="清除搜索" Click="ClearLibrarySearch" Style="{StaticResource QuietButton}" Visibility="{Binding HasAppliedSearch,Converter={StaticResource VisibleWhenTrue}}"/><TextBlock Text="{Binding LibraryCountText}" Style="{StaticResource Meta}" VerticalAlignment="Center"/></DockPanel>
        <ItemsControl ItemsSource="{Binding LibraryItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        <StackPanel Margin="0,70,0,0" HorizontalAlignment="Center" MaxWidth="400" Visibility="{Binding LibraryEmpty,Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="{Binding LibraryEmptyTitle}" Style="{StaticResource SectionTitle}" TextAlignment="Center"/><TextBlock Text="{Binding LibraryEmptyDescription}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,20"/><Button Content="清除搜索" Click="ClearLibrarySearch" HorizontalAlignment="Center" Visibility="{Binding HasAppliedSearch,Converter={StaticResource VisibleWhenTrue}}"/><Button Content="导入已有结果" Click="ImportExports" HorizontalAlignment="Center" Visibility="{Binding HasAppliedSearch,Converter={StaticResource VisibleWhenFalse}}"/></StackPanel>
      </StackPanel></ScrollViewer>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsVoicesPage,Converter={StaticResource VisibleWhenTrue}}"><StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><RadioButton Content="中文" GroupName="AudioLanguage" Style="{StaticResource PreviewView}" IsChecked="{Binding AudioLanguage,Converter={StaticResource PageMatch},ConverterParameter=zhCN}"/><RadioButton Content="英文" GroupName="AudioLanguage" Style="{StaticResource PreviewView}" IsChecked="{Binding AudioLanguage,Converter={StaticResource PageMatch},ConverterParameter=enUS}"/><RadioButton Content="关联音效" GroupName="AudioLanguage" Style="{StaticResource PreviewView}" IsChecked="{Binding AudioLanguage,Converter={StaticResource PageMatch},ConverterParameter=SFX}"/></StackPanel>
        <ItemsControl ItemsSource="{Binding AudioRows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="4,20"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" Foreground="#536D60"/><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Description}" Style="{StaticResource Meta}" Margin="0,6,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding AudioSourceText}" Style="{StaticResource Meta}" Margin="4,22,0,20" TextWrapping="Wrap"/><Button Content="导入历史声音统计" Click="ImportAudioSummary" HorizontalAlignment="Left"/>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="{Binding IsEmptyPage,Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="{Binding EmptyPageTitle}" Style="{StaticResource SectionTitle}" TextAlignment="Center"/><TextBlock Text="{Binding EmptyPageDescription}" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,22"/><Button Content="浏览模型资源" Click="Navigate" Tag="models" HorizontalAlignment="Center"/></StackPanel>
      <DockPanel x:Name="QueueArea" Grid.Row="1" Visibility="{Binding IsQueuePage,Converter={StaticResource VisibleWhenTrue}}">
        <StackPanel DockPanel.Dock="Top"><DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="移除" Click="RemoveJob" IsEnabled="{Binding CanRemove}" Margin="0,0,8,0"/><Button Content="重试" Click="RetryJob" IsEnabled="{Binding CanRetry}" Margin="0,0,8,0"/><Button x:Name="RunQueueButton" Content="开始提取" Style="{StaticResource Primary}" Click="RunJobs" IsEnabled="{Binding CanRun}" ToolTip="离线时仅保存任务；退出游戏后在设置中启用读取"/><Button Content="取消任务" Click="CancelJobs" IsEnabled="{Binding CanCancel}" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{Binding QueueSummary}" Style="{StaticResource Meta}" VerticalAlignment="Center"/></DockPanel><Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="12,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="资源" Style="{StaticResource Meta}"/><TextBlock Grid.Column="1" Text="状态" Style="{StaticResource Meta}"/><TextBlock Grid.Column="2" Text="内容 / 结果" Style="{StaticResource Meta}"/></Grid></Border></StackPanel>
        <Expander DockPanel.Dock="Bottom" Header="运行日志" Margin="0,18,0,0"><TextBox Text="{Binding Log,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="{StaticResource CaptionSize}"/></Expander>
        <Grid><ListBox x:Name="JobGrid" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" ItemContainerStyle="{StaticResource ResourceRow}" AutomationProperties.Name="提取任务列表"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Margin="0,10"><TextBlock Text="{Binding ContentSummary}" Style="{StaticResource Meta}" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasJobs,Converter={StaticResource VisibleWhenFalse}}"><TextBlock Text="队列还是空的" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/><TextBlock Text="选择资源和导出内容，即可加入待执行队列。" Foreground="{StaticResource Secondary}" Margin="0,12,0,20"/><Button Content="浏览模型资源" Click="Navigate" Tag="models" HorizontalAlignment="Center"/></StackPanel></Grid>
      </DockPanel>
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsPage,Converter={StaticResource VisibleWhenTrue}}"><StackPanel MaxWidth="800" HorizontalAlignment="Left" IsEnabled="{Binding CanEdit}" Margin="0,0,20,0">
        <TextBlock Text="3D 预览" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ActiveRenderLabel}" Style="{StaticResource Meta}" Margin="0,6,0,20"/>
        <RadioButton Content="软件渲染" GroupName="RenderPreference" IsChecked="{Binding SoftwarePreferred}"/><TextBlock Text="拖动时使用轻量预览，松手恢复完整模型。" Style="{StaticResource Meta}" Margin="22,6,0,18"/>
        <RadioButton Content="硬件优先" GroupName="RenderPreference" IsChecked="{Binding HardwarePreferred}"/><TextBlock Text="GPU 可用时加速，不支持时回退；建议退出游戏后使用。" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,6,0,22"/>
        <StackPanel Orientation="Horizontal"><TextBlock Text="目标帧率" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox ItemsSource="{Binding PreviewFrameRates}" SelectedItem="{Binding PreviewTargetFps}" Width="110" AutomationProperties.Name="目标帧率"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} FPS}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><CheckBox Content="显示性能信息" IsChecked="{Binding ShowPreviewPerformance}" Margin="24,0,0,0" VerticalAlignment="Center"/></StackPanel>
        <Border Background="#F0F5EF" CornerRadius="6" Padding="14" Margin="0,20,0,26"><TextBlock Text="{Binding RenderPreferenceHint}" Style="{StaticResource Meta}" TextWrapping="Wrap"/></Border>
        <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="0,22,0,0"><StackPanel><TextBlock Text="本地资源" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ModeLabel}" Foreground="#536D60" Margin="0,16,0,6"/><TextBlock Text="浏览历史结果无需配置游戏目录。" Style="{StaticResource Meta}" Margin="0,0,0,22"/></StackPanel></Border>
        <Expander Header="提取设置（退出游戏后使用）" Margin="0,0,0,20"><StackPanel>
          <TextBlock Text="DataTool 引擎" Margin="0,0,0,8"/><DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="选择文件" Click="ChooseEngine" Margin="8,0,0,0"/><TextBox Text="{Binding Settings.EnginePath,UpdateSourceTrigger=PropertyChanged}" Tag="DataTool.exe" MinWidth="420"/></DockPanel>
          <TextBlock Text="游戏目录" Margin="0,0,0,8"/><DockPanel Margin="0,0,0,18" IsEnabled="{Binding CanToggleLive}"><Button DockPanel.Dock="Right" Content="选择目录" Click="ChooseGame" Margin="8,0,0,0"/><TextBox Text="{Binding Settings.GamePath,UpdateSourceTrigger=PropertyChanged}" Tag="仅在退出游戏后配置"/></DockPanel>
          <TextBlock Text="提取输出目录" Margin="0,0,0,8"/><DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="选择目录" Click="ChooseOutput" Margin="8,0,0,0"/><TextBox Text="{Binding Settings.OutputPath,UpdateSourceTrigger=PropertyChanged}" Tag="每个任务使用独立子目录"/></DockPanel>
          <TextBlock Text="资源语言" Margin="0,0,0,8"/><ComboBox SelectedValue="{Binding Settings.Language}" SelectedValuePath="Tag" Width="220" HorizontalAlignment="Left" Margin="0,0,0,20" AutomationProperties.Name="资源语言"><ComboBoxItem Content="英语 · enUS" Tag="enUS"/><ComboBoxItem Content="简体中文 · zhCN" Tag="zhCN"/><ComboBoxItem Content="繁体中文 · zhTW" Tag="zhTW"/></ComboBox>
          <CheckBox Content="允许读取游戏" IsChecked="{Binding LiveEnabled}" IsEnabled="{Binding CanToggleLive}" AutomationProperties.Name="允许读取游戏" Margin="0,0,0,18"/><Button Content="从游戏刷新目录" Click="RefreshLive" IsEnabled="{Binding CanReadGame}" HorizontalAlignment="Left"/>
        </StackPanel></Expander>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button Content="保存设置" Click="SavePreviewSettings" Style="{StaticResource Primary}"/><Button Content="返回模型" Click="Navigate" Tag="models" Style="{StaticResource QuietButton}" Margin="10,0,0,0"/></StackPanel>
      </StackPanel></ScrollViewer>
      <Border Grid.Row="2" Background="#EAF0E9" CornerRadius="6" Padding="12,8" Margin="0,12,0,0" Visibility="{Binding QueueNotice,Converter={StaticResource VisibleWhenTrue}}"><DockPanel><Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource QuietButton}" Click="DismissQueueNotice"/><Button DockPanel.Dock="Right" Content="查看队列" Style="{StaticResource QuietButton}" Click="Navigate" Tag="queue"/><TextBlock Text="{Binding QueueNoticeText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></Border>
      <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock DockPanel.Dock="Right" Text="OWExtractor · 0.4.0 开发预览" Style="{StaticResource Meta}" Margin="16,0,0,0"/><TextBlock Text="{Binding Status}" Style="{StaticResource Meta}" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Grid>
    <Border x:Name="ExpandedPreview" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="#660E1D15" Padding="20" Visibility="{Binding PreviewExpanded,Converter={StaticResource VisibleWhenTrue}}" KeyboardNavigation.TabNavigation="Cycle">
      <Border Background="White" CornerRadius="10" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16"><Button x:Name="ClosePreviewButton" DockPanel.Dock="Right" Content="收起预览  ×" ToolTip="Esc" Click="ClosePreview" Margin="16,0,0,0"/><TextBlock Text="{Binding PageTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
          <Border Grid.Row="1" Background="{StaticResource LibraryCanvas}" CornerRadius="8" Padding="12"><Grid><Image Source="{Binding PreviewImage}" Stretch="Uniform" Visibility="{Binding ShowCachedPreview,Converter={StaticResource VisibleWhenTrue}}"/><local:ModelViewport x:Name="ExpandedModelViewport" Scene="{Binding Scene}" Orbit="{Binding Camera}" SoftwareRendering="{Binding SoftwareRendering}" TargetFps="{Binding PreviewTargetFps}" ShowPerformance="{Binding ShowPreviewPerformance}" Visibility="{Binding HasModel,Converter={StaticResource VisibleWhenTrue}}"/></Grid></Border>
          <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False"><TextBlock Text="{Binding PreviewHint}" Style="{StaticResource Meta}" VerticalAlignment="Center" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><RadioButton Content="正面" GroupName="ExpandedView" Style="{StaticResource PreviewView}" IsChecked="{Binding FrontView}" IsEnabled="{Binding HasFrontPreview}"/><RadioButton Content="背面" GroupName="ExpandedView" Style="{StaticResource PreviewView}" IsChecked="{Binding RearView}" IsEnabled="{Binding HasBackPreview}"/><Button Content="−" Click="ZoomOutModel" Style="{StaticResource QuietButton}" IsEnabled="{Binding HasModel}" ToolTip="缩小"/><TextBlock Text="{Binding ZoomText}" Style="{StaticResource Meta}" Width="46" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Click="ZoomInModel" Style="{StaticResource QuietButton}" IsEnabled="{Binding HasModel}" ToolTip="放大"/><Button Content="适应窗口" Click="FitModel" Style="{StaticResource QuietButton}" IsEnabled="{Binding HasModel}"/></StackPanel></DockPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
