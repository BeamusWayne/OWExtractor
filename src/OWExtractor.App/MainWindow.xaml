<Window x:Class="OWExtractor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OWExtractor · 守望先锋资源提取" Width="1360" Height="960" MinWidth="1100" MinHeight="820" Background="#F3F5F8" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal"><Border Width="42" Height="42" Background="#E87722" CornerRadius="9" Margin="0,0,12,0"><TextBlock Text="OW" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="OWExtractor" FontSize="26" FontWeight="Bold"/><TextBlock Text="守望先锋资源提取 · 中文桌面客户端" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
      <TextBlock Text="v0.1.0 · 开发预览" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
    </Grid>
    <Border Grid.Row="1" Background="#FFF3E3" BorderBrush="#F1D6AE" BorderThickness="1" CornerRadius="7" Padding="14,11" Margin="0,0,0,14">
      <DockPanel><TextBlock Text="{Binding ModeText}" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox Content="允许读取已退出的游戏" IsChecked="{Binding LiveEnabled}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Right" ToolTip="本次启动默认关闭。游戏运行时仍会阻止 DataTool 启动。"/></DockPanel>
    </Border>
    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,14">
      <Grid IsEnabled="{Binding CanEdit}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Grid Margin="0,0,18,10"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="提取引擎" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Settings.EnginePath,UpdateSourceTrigger=PropertyChanged}" ToolTip="DataTool.exe 路径；设置路径不会启动引擎"/><Button Grid.Column="2" Content="选择" Click="ChooseEngine" Margin="8,0,0,0"/></Grid>
        <Grid Grid.Column="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="游戏目录" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Settings.GamePath,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="选择" Click="ChooseGame" Margin="8,0,0,0"/></Grid>
        <Grid Grid.Row="1" Margin="0,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="导出目录" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Settings.OutputPath,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="选择" Click="ChooseOutput" Margin="8,0,0,0"/></Grid>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="资源语言" Width="72" VerticalAlignment="Center"/><ComboBox Width="100" SelectedValue="{Binding Settings.Language}" SelectedValuePath="Content" VerticalContentAlignment="Center"><ComboBoxItem Content="enUS"/><ComboBoxItem Content="zhCN"/><ComboBoxItem Content="zhTW"/></ComboBox><Button Content="保存设置" Click="SaveSettings" Margin="12,0,8,0"/><Button Content="从游戏刷新目录" Click="RefreshLive" IsEnabled="{Binding CanRun}" ToolTip="会读取游戏文件；离线模式或游戏运行时不可执行"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="3" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="8" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="英雄目录" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/><TextBox Text="{Binding HeroSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索中文或原始名称" Margin="0,0,0,10"/></StackPanel><ListBox ItemsSource="{Binding Heroes}" SelectedItem="{Binding SelectedHero}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Summary}" Foreground="#758298" FontSize="11" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
      <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding HeroTitle}" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding CatalogSummary}" Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
          <WrapPanel IsEnabled="{Binding CanEdit}" Margin="0,0,0,10"><Button Content="导入英雄 JSON" Click="ImportHeroes"/><Button Content="合并中文名称" Click="ImportLocalized"/><Button Content="导入皮肤 JSON" Click="ImportUnlocks"/><Button Content="导入既有导出目录" Click="ImportExports"/></WrapPanel>
          <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="加入提取队列" Style="{StaticResource Primary}" Click="AddJobs" IsEnabled="{Binding CanEdit}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="全选" Click="SelectAll" Margin="8,0,0,0"/><TextBox Text="{Binding SkinSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索皮肤名称"/></DockPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="打开已有结果" Click="OpenExport"/><Button Content="查看提取命令" Click="PreviewCommand"/><TextBlock Text="Ctrl / Shift 可多选" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0"/></StackPanel>
        <DataGrid x:Name="SkinGrid" ItemsSource="{Binding VisibleSkins}" SelectionMode="Extended" SelectionUnit="FullRow"><DataGrid.Columns><DataGridTextColumn Header="皮肤" Binding="{Binding Name}" Width="230"/><DataGridTextColumn Header="来源" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="本地文件" Binding="{Binding Details}" Width="430"/></DataGrid.Columns></DataGrid>
      </DockPanel></Border>
    </Grid>
    <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="14"><DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="提取任务" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="开始队列" Style="{StaticResource Primary}" Click="RunJobs" IsEnabled="{Binding CanRun}"/><Button Content="取消执行" Click="CancelJobs" IsEnabled="{Binding Busy}"/><Button Content="重试选中" Click="RetryJob" IsEnabled="{Binding CanEdit}"/><Button Content="移除选中" Click="RemoveJob" IsEnabled="{Binding CanEdit}"/><Button Content="打开任务目录" Click="OpenJob"/></StackPanel>
      <TabControl BorderThickness="0"><TabItem Header="任务队列"><DataGrid x:Name="JobGrid" ItemsSource="{Binding Jobs}" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="英雄 / 皮肤" Binding="{Binding Title}" Width="240"/><DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="800"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="运行日志"><TextBox Text="{Binding Log,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" BorderThickness="0"/></TabItem></TabControl>
    </DockPanel></Border>
    <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="{StaticResource Muted}" Margin="2,12,0,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
